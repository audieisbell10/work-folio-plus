{
  // Cloudflare Worker config for this TanStack Start (Nitro) app.
  // Paths are relative to the repo root and match what `npm run build` produces in .output/.
  // Note: `npm run build` also generates .wrangler/deploy/config.json, which points wrangler
  // at .output/server/wrangler.json. When that exists (i.e. right after a build, including in
  // Cloudflare's build), wrangler uses it automatically. This file is the equivalent config
  // kept in source so the project is self-describing and works even before the first build.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "audieisbell",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-07-05",
  "compatibility_flags": ["nodejs_compat"],
  // Client Gallery photos. Each top-level folder in the bucket is one shoot.
  "r2_buckets": [{ "binding": "CLIENT_PHOTOS", "bucket_name": "hoco2026" }],
  // Resizes gallery thumbnails inside the password-checked photo route
  // (src/routes/client-photos.$.ts), so resized copies never sit in a public cache.
  "images": { "binding": "IMAGES" },
  // The gallery password is a secret, not set here:
  //   npx wrangler secret put CLIENT_GALLERY_PASSWORD
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  },
  // The server bundle ships as separate ES module chunks in .output/server; don't re-bundle them.
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"]
    }
  ]
}
